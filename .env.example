# Copy to .env and fill in. Never commit .env.

# --- Database / queue ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_automation?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Auth (Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Needed behind proxies (Codespaces, Vercel, etc.)
AUTH_TRUST_HOST=true
# Extra hostnames allowed to load the dev server, e.g. a tunnel: "social.yet-kenya.com"
ALLOWED_DEV_ORIGINS=""

# Social sign-in for users (each is enabled when both values are set).
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client (Web), redirect URI <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Facebook: your Meta app -> Facebook Login -> redirect URI <AUTH_URL>/api/auth/callback/facebook
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
# Testing only: a stand-in login provider (node scripts/dev/mock-oauth.mjs). Never set in production.
# MOCK_OAUTH_URL="http://localhost:4040"

# First super admin, created by `npm run db:seed`. Staff have no public sign-up.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Admin"

# --- Token encryption ---
# 32-byte key, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Meta (Facebook / Instagram / WhatsApp) ---
# From https://developers.facebook.com/apps -> your app -> Settings -> Basic
META_APP_ID=""
META_APP_SECRET=""
# Check https://developers.facebook.com/docs/graph-api/changelog for the current version
META_GRAPH_API_VERSION="v23.0"
# Any random string; must match what you enter in the Meta webhook settings
META_WEBHOOK_VERIFY_TOKEN=""
# Optional: use Facebook Login for Business with a configuration ID instead of a scope list
# META_LOGIN_CONFIG_ID=""
# Testing only: point at a mock Meta server
# META_GRAPH_BASE_URL="http://localhost:4020"
# META_DIALOG_BASE_URL="http://localhost:4020"

# WhatsApp Cloud API (from WhatsApp -> API Setup in the Meta app dashboard).
# Optional: if set, the Accounts page offers a one-click "connect from server settings".
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""

# --- OpenAI (image generation + content moderation) ---
# https://platform.openai.com/api-keys. GPT image models need a verified organization.
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-2"
# low | medium | high (cost rises with quality)
OPENAI_IMAGE_QUALITY="medium"
# Max generated images per user per 24 hours
IMAGE_DAILY_LIMIT=20
# Optional: override the API base URL (e.g. a proxy or a local mock)
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Public base URL for post images Meta downloads (defaults to AUTH_URL)
# PUBLIC_BASE_URL="https://social.yet-kenya.com"

# --- X (Twitter) ---
# OAuth 2.0 client from https://developer.x.com (confidential client, Read and write)
# Callback URL: <AUTH_URL>/api/x/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# --- TikTok ---
# From https://developers.tiktok.com (Login Kit + Content Posting API)
# Redirect URI: <AUTH_URL>/api/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Unaudited apps can only post SELF_ONLY. After TikTok approves the app, e.g. PUBLIC_TO_EVERYONE
# TIKTOK_PRIVACY_LEVEL="SELF_ONLY"

# --- Scheduling ---
# Timezone for channel schedules (IANA name)
APP_TIMEZONE="Africa/Nairobi"
# How often the worker checks for due schedules, in milliseconds
# SCHEDULER_TICK_MS=30000

# Testing only: point X/TikTok at mock servers
# X_AUTH_BASE_URL="http://localhost:4030/x"
# X_API_BASE_URL="http://localhost:4030/x"
# TIKTOK_AUTH_BASE_URL="http://localhost:4030/tt"
# TIKTOK_API_BASE_URL="http://localhost:4030/tt"

# --- Audience (public subscribe page + WhatsApp adverts) ---
# Name shown on the public subscribe page
BRAND_NAME="Social Automation"
# Country code added to local numbers like 0712 345 678
DEFAULT_COUNTRY_CODE="254"
# Minimum hours between adverts to the same subscriber
AUDIENCE_MIN_HOURS_BETWEEN_MESSAGES=24
# Optional default for the WhatsApp template (normally set on the Audience page)
# AUDIENCE_WHATSAPP_TEMPLATE="audience_offer"
# AUDIENCE_WHATSAPP_TEMPLATE_LANG="en_US"
