generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum MediaSource {
  GENERATED
  UPLOADED
}

enum TargetStatus {
  PENDING
  PUBLISHED
  FAILED
}

// Users are created by an admin (seed script or `npm run user:create`). No self sign-up.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]
  media MediaAsset[]
}

// A connected Facebook Page, Instagram Business account, or WhatsApp phone number.
model SocialAccount {
  id                   String    @id @default(cuid())
  platform             Platform
  externalId           String // Page ID, IG user ID, or WhatsApp phone number ID
  displayName          String
  accessTokenEncrypted String // AES-256-GCM, see src/lib/crypto.ts
  tokenExpiresAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  targets PostTarget[]

  @@unique([platform, externalId])
}

model Post {
  id          String     @id @default(cuid())
  content     String
  mediaUrls   String[]
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  // Last policy review per platform (see src/lib/policy/review.ts)
  checks      Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  targets PostTarget[]
}

// One row per (post, account) so each platform succeeds or fails independently.
model PostTarget {
  id             String       @id @default(cuid())
  status         TargetStatus @default(PENDING)
  externalPostId String?
  error          String?
  // WhatsApp only: recipient phone number in international format
  recipient      String?

  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountId String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([postId, accountId, recipient])
}

// Raw webhook payloads from Meta, stored for processing/debugging.
model WebhookEvent {
  id          String    @id @default(cuid())
  object      String // "page", "instagram", "whatsapp_business_account"
  payload     Json
  processedAt DateTime?
  receivedAt  DateTime  @default(now())
}

// Images used in posts. Served publicly at /api/media/<id> so Meta can fetch them.
// Stored in Postgres for simplicity; move to object storage (S3/R2) before scaling.
model MediaAsset {
  id         String      @id @default(cuid())
  source     MediaSource
  mimeType   String
  width      Int
  height     Int
  sizeBytes  Int
  data       Bytes
  prompt     String?
  // Raw moderation result for the image
  moderation Json?
  // True when the image fails content rules on every platform; it is then never served
  blocked    Boolean     @default(false)
  createdAt  DateTime    @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([createdById, createdAt])
}
