generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER: signs in with Google/Facebook and subscribes to adverts.
// ADMIN: runs adverts, channels, audience and users. SUPER_ADMIN: also promotes and demotes admins.
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  X
  TIKTOK
}

// POST = feed post (or a WhatsApp message); STORY = Facebook/Instagram story
enum PostFormat {
  POST
  STORY
}

// Parent containers on the Channels page: Meta groups Facebook, Instagram and WhatsApp.
enum GroupKind {
  META
  X
  TIKTOK
}

enum Frequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum MediaSource {
  GENERATED
  UPLOADED
}

enum TargetStatus {
  PENDING
  PUBLISHED
  FAILED
}

// Users are created by an admin (seed script or `npm run user:create`). No self sign-up.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  image        String?
  // Staff sign in with a password; users sign in with Google/Facebook (no password)
  passwordHash String?
  role         Role      @default(USER)
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts         Account[]
  sessions         UserSession[]
  activity         ActivityLog[]
  subscriptions    AdvertSubscription[]
  socials          UserSocial[]
  socialDeliveries SocialDelivery[]
  // The user's WhatsApp number record (for adverts they subscribe to on WhatsApp)
  subscriber       Subscriber?
  // Linking a WhatsApp number: it's only linked when "JOIN <code>" arrives from that number
  whatsappPending  String?
  whatsappCode     String?              @unique

  posts Post[]
  media MediaAsset[]

  approvedCampaigns Campaign[]
  addedSubscribers  Subscriber[] @relation("AddedSubscribers")
}

// A connected Facebook Page, Instagram account, WhatsApp number, X account or TikTok account.
model SocialAccount {
  id                    String    @id @default(cuid())
  platform              Platform
  externalId            String // Page ID, IG user ID, WhatsApp phone number ID, X user ID, TikTok open_id
  displayName           String
  accessTokenEncrypted  String // AES-256-GCM, see src/lib/crypto.ts
  // X and TikTok issue short-lived access tokens plus a refresh token
  refreshTokenEncrypted String?
  // The account's real handle as reported by the platform (Page username, @username, phone digits)
  handle                String?
  profileUrl            String?
  tokenExpiresAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  targets PostTarget[]

  @@unique([platform, externalId])
}

model Post {
  id            String     @id @default(cuid())
  content       String
  mediaUrls     String[]
  // Advert images made for each platform: { "INSTAGRAM": "<media url>", ... }. mediaUrls[0] is the main one (home page).
  platformMedia Json?
  status        PostStatus @default(DRAFT)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  // Last policy review per platform (see src/lib/policy/review.ts)
  checks        Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // Set when this post was created by a channel's schedule
  channelId String?
  channel   Channel? @relation("ChannelRuns", fields: [channelId], references: [id], onDelete: SetNull)

  // Channels using this post as their advert
  advertFor Channel[] @relation("ChannelAdvert")

  // Audience targeting: subscribers interested in any of these topics (and in these locations, if set)
  interests       Interest[]
  targetLocations String[]
  campaigns       Campaign[]

  // Advert details set by the admin; listed adverts are shown to users, who subscribe to them
  title            String?
  about            String?
  targetPlatforms  Platform[]
  listedAt         DateTime?
  // When a published advert goes out (posted on its platforms, sent to WhatsApp subscribers)
  sendAt           DateTime?
  // Publishing counts as approval: WhatsApp subscribers get it automatically (false = approve each send)
  autoSend         Boolean              @default(true)
  subscriptions    AdvertSubscription[]
  socialDeliveries SocialDelivery[]

  // Posts made from this advert on social platforms (shown in subscribers' feeds)
  sourceAdvertId String?
  sourceAdvert   Post?   @relation("AdvertPosts", fields: [sourceAdvertId], references: [id], onDelete: SetNull)
  advertPosts    Post[]  @relation("AdvertPosts")

  targets PostTarget[]
}

// One row per (post, account) so each platform succeeds or fails independently.
model PostTarget {
  id             String       @id @default(cuid())
  status         TargetStatus @default(PENDING)
  externalPostId String?
  error          String?
  format         PostFormat   @default(POST)
  // WhatsApp only: recipient phone number in international format
  recipient      String?

  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountId String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([postId, accountId, recipient])
}

// Raw webhook payloads from Meta, stored for processing/debugging.
model WebhookEvent {
  id          String    @id @default(cuid())
  object      String // "page", "instagram", "whatsapp_business_account"
  payload     Json
  processedAt DateTime?
  receivedAt  DateTime  @default(now())
}

// Images used in posts. Served publicly at /api/media/<id> so Meta can fetch them.
// Stored in Postgres for simplicity; move to object storage (S3/R2) before scaling.
model MediaAsset {
  id         String      @id @default(cuid())
  source     MediaSource
  mimeType   String
  width      Int
  height     Int
  sizeBytes  Int
  data       Bytes
  prompt     String?
  // Raw moderation result for the image
  moderation Json?
  // True when the image fails content rules on every platform; it is then never served
  blocked    Boolean     @default(false)
  createdAt  DateTime    @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([createdById, createdAt])
}

// A parent container (Meta, X or TikTok) holding one social container per platform.
model ChannelGroup {
  id        String    @id @default(cuid())
  kind      GroupKind @unique
  createdAt DateTime  @default(now())
  channels  Channel[]
}

// One social container per platform: which handle, which advert, as a post or story, and when.
model Channel {
  id       String     @id @default(cuid())
  platform Platform   @unique
  format   PostFormat @default(POST)

  groupId String
  group   ChannelGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // The handle the admin expects to post to; only connected accounts matching it are used
  handle String?

  advertId String?
  advert   Post?   @relation("ChannelAdvert", fields: [advertId], references: [id], onDelete: SetNull)

  frequency  Frequency @default(DAILY)
  // ONCE: exact time to post
  runAt      DateTime?
  // DAILY/WEEKLY/MONTHLY: local time of day "HH:MM" in `timezone`
  timeOfDay  String    @default("09:00")
  // WEEKLY: 0 = Sunday ... 6 = Saturday
  weekdays   Int[]
  // MONTHLY: 1-31 (falls back to the month's last day)
  dayOfMonth Int?
  timezone   String    @default("Africa/Nairobi")

  enabled   Boolean   @default(false)
  nextRunAt DateTime?
  lastRunAt DateTime?
  lastError String?

  // WhatsApp only
  whatsappRecipients   String[]
  whatsappTemplate     String?
  whatsappTemplateLang String   @default("en_US")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs Post[] @relation("ChannelRuns")

  @@index([enabled, nextRunAt])
}

// ---- Audience: people who subscribed to receive adverts ----------------------------

// PENDING: waiting for the person to confirm their number on WhatsApp
// NEEDS_REVIEW: an automatic check flagged it for an admin
// ACTIVE: accepted (automatically or by an admin) and receiving adverts
enum SubscriberStatus {
  PENDING
  NEEDS_REVIEW
  ACTIVE
  REJECTED
  UNSUBSCRIBED
}

enum CampaignStatus {
  PENDING_APPROVAL
  APPROVED
  SENDING
  SENT
  REJECTED
  FAILED
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

// Topics subscribers choose and adverts are tagged with. Managed by admins.
model Interest {
  id          String       @id @default(cuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  subscribers Subscriber[]
  adverts     Post[]
}

model Subscriber {
  id        String           @id @default(cuid())
  name      String
  // WhatsApp number, digits only in international format (e.g. 254712345678)
  phone     String           @unique
  location  String?
  status    SubscriberStatus @default(PENDING)
  interests Interest[]

  // Set when a signed-in user added their WhatsApp number from their dashboard
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Opt-in record (WhatsApp requires businesses to have it before messaging)
  consentText String
  consentAt   DateTime
  consentIp   String?
  // "subscribe_page", or "admin" / "import" with the admin's description of how consent was collected
  source      String   @default("subscribe_page")
  addedById   String?
  addedBy     User?    @relation("AddedSubscribers", fields: [addedById], references: [id], onDelete: SetNull)

  // Number ownership: the person sends "JOIN <code>" to the business on WhatsApp
  confirmCode String?   @unique
  confirmedAt DateTime?

  // Automatic approval: each policy check and its result, and who decided ("auto" or an admin's email)
  checks    Json?
  decidedAt DateTime?
  decidedBy String?

  // Secret for the subscriber's own "manage / unsubscribe" link
  manageToken    String    @unique
  unsubscribedAt DateTime?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deliveries Delivery[]

  @@index([status])
}

// A proposed send of one advert to its matched subscribers. Created automatically; an admin approves it.
model Campaign {
  id        String         @id @default(cuid())
  status    CampaignStatus @default(PENDING_APPROVAL)
  // Why it was proposed, e.g. "New advert" or "3 new subscribers match"
  reason    String
  createdAt DateTime       @default(now())

  advertId String
  advert   Post   @relation(fields: [advertId], references: [id], onDelete: Cascade)

  // When the approved send goes out (null = straight away)
  sendAt       DateTime?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation(fields: [approvedById], references: [id])
  rejectedAt   DateTime?
  error        String?
  // Platform check result for WhatsApp at proposal / send time
  checks       Json?

  deliveries Delivery[]

  @@index([status])
}

model Delivery {
  id         String         @id @default(cuid())
  status     DeliveryStatus @default(PENDING)
  externalId String?        @unique // WhatsApp message ID, for status webhooks
  error      String?
  sentAt     DateTime?
  createdAt  DateTime       @default(now())

  campaignId   String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
}

// Small admin-editable settings (e.g. the WhatsApp template used for audience adverts).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---- Accounts, sessions and activity -------------------------------------------------

// A social login linked to a user (Google, Facebook)
model Account {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Every sign-in creates one; the session cookie carries its ID and is checked against it on each request.
model UserSession {
  id         String    @id @default(cuid())
  provider   String
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  // e.g. SIGN_IN, SIGN_OUT, SUBSCRIBE, UNSUBSCRIBE, ROLE_CHANGE, SESSIONS_REVOKED, WHATSAPP_ADDED
  action    String
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Who did it, when it isn't the user themselves (e.g. a super admin changing a role)
  actorId   String?

  @@index([userId, createdAt])
  // The admin Logs page: newest first, filtered by action
  @@index([createdAt])
  @@index([action, createdAt])
}

// A user's subscription to one advert on one platform handle
model AdvertSubscription {
  id        String   @id @default(cuid())
  platform  Platform
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  advertId  String
  advert    Post     @relation(fields: [advertId], references: [id], onDelete: Cascade)

  @@unique([userId, advertId, platform])
  @@index([advertId, platform])
}

// A user's own handles, entered on their profile. Adverts they subscribe to on X are sent there
// by direct message, and on Instagram by an @mention; Facebook and TikTok can't deliver to a person.
model UserSocial {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  Platform
  handle    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform])
}

// One advert sent to one user's handle (X DM or Instagram mention).
model SocialDelivery {
  id         String         @id @default(cuid())
  advertId   String
  advert     Post           @relation(fields: [advertId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   Platform
  handle     String
  status     DeliveryStatus @default(PENDING)
  attempts   Int            @default(0)
  error      String?
  externalId String?
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([advertId, userId, platform])
  @@index([status])
}
